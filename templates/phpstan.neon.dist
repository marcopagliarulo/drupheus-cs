parameters:
	level: 6
	paths:
		- %PATH%
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# Drupal render arrays and hook signatures cannot be fully described.
		-
			identifier: missingType.iterableValue
			reportUnmatched: false

	# Every rule below is on by default. Uncomment one to turn it off.
