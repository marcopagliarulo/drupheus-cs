parameters:
	drupheusCs:
		# Lowest Drupal version the code must run on, for example '11.2'. When
		# NULL it is read from core_version_requirement in the nearest info.yml.
		minimumCoreVersion: null
		autowire:
			# Also report classes that cannot use autowiring, and why. This is
			# what `drupheus-cs autowire` turns on.
			reportUnavailable: false
		variableCase:
			# Either lowerCamelCase or snake_case.
			style: lowerCamelCase
		# Rules from the coding standards that Coder does not enforce.
		standard:
			nativeTypeHints: true
			namingConventions: true
		# Modernization rules beyond the coding standards.
		extras:
			variableCase: true
			constructorPromotion: true
			autowire: true
			classHooks: true
			pluginAttributes: true
			typedProperties: true

parametersSchema:
	drupheusCs: structure([
		minimumCoreVersion: schema(string(), nullable())
		autowire: structure([
			reportUnavailable: bool()
		])
		variableCase: structure([
			style: anyOf('lowerCamelCase', 'snake_case')
		])
		standard: structure([
			nativeTypeHints: bool()
			namingConventions: bool()
		])
		extras: structure([
			variableCase: bool()
			constructorPromotion: bool()
			autowire: bool()
			classHooks: bool()
			pluginAttributes: bool()
			typedProperties: bool()
		])
	])

conditionalTags:
	DrupheusCs\PHPStan\Rule\VariableCaseRule:
		phpstan.rules.rule: %drupheusCs.extras.variableCase%
	DrupheusCs\PHPStan\Rule\ConstructorPromotionRule:
		phpstan.rules.rule: %drupheusCs.extras.constructorPromotion%
	DrupheusCs\PHPStan\Rule\NativeTypeHintsRule:
		phpstan.rules.rule: %drupheusCs.standard.nativeTypeHints%
	DrupheusCs\PHPStan\Rule\NullableReturnRule:
		phpstan.rules.rule: %drupheusCs.standard.nativeTypeHints%
	DrupheusCs\PHPStan\Rule\NamingConventionsRule:
		phpstan.rules.rule: %drupheusCs.standard.namingConventions%
	DrupheusCs\PHPStan\Rule\StateKeyRule:
		phpstan.rules.rule: %drupheusCs.standard.namingConventions%
	DrupheusCs\PHPStan\Rule\RequestAttributeRule:
		phpstan.rules.rule: %drupheusCs.standard.namingConventions%
	DrupheusCs\PHPStan\Rule\FilterPlaceholderRule:
		phpstan.rules.rule: %drupheusCs.standard.namingConventions%
	DrupheusCs\PHPStan\Rule\Psr4LocationRule:
		phpstan.rules.rule: %drupheusCs.standard.namingConventions%
	DrupheusCs\PHPStan\Rule\FactoryAutowireRule:
		phpstan.rules.rule: %drupheusCs.extras.autowire%
	DrupheusCs\PHPStan\Rule\ServiceAutowireRule:
		phpstan.rules.rule: %drupheusCs.extras.autowire%
	DrupheusCs\PHPStan\Rule\ProceduralHooksRule:
		phpstan.rules.rule: %drupheusCs.extras.classHooks%
	DrupheusCs\PHPStan\Rule\PluginAttributesRule:
		phpstan.rules.rule: %drupheusCs.extras.pluginAttributes%
	DrupheusCs\PHPStan\Rule\TypedPropertiesRule:
		phpstan.rules.rule: %drupheusCs.extras.typedProperties%

services:
	- DrupheusCs\PHPStan\Drupal\ExtensionLocator
	-
		class: DrupheusCs\PHPStan\Drupal\CoreVersion
		arguments:
			override: %drupheusCs.minimumCoreVersion%
	- DrupheusCs\PHPStan\Drupal\ConstructorAutowireAnalyzer
	-
		class: DrupheusCs\PHPStan\Rule\VariableCaseRule
		arguments:
			style: %drupheusCs.variableCase.style%
	- DrupheusCs\PHPStan\Rule\ConstructorPromotionRule
	- DrupheusCs\PHPStan\Rule\NativeTypeHintsRule
	- DrupheusCs\PHPStan\Rule\NullableReturnRule
	- DrupheusCs\PHPStan\Rule\NamingConventionsRule
	- DrupheusCs\PHPStan\Rule\StateKeyRule
	- DrupheusCs\PHPStan\Rule\RequestAttributeRule
	- DrupheusCs\PHPStan\Rule\FilterPlaceholderRule
	- DrupheusCs\PHPStan\Rule\Psr4LocationRule
	-
		class: DrupheusCs\PHPStan\Rule\FactoryAutowireRule
		arguments:
			reportUnavailable: %drupheusCs.autowire.reportUnavailable%
	-
		class: DrupheusCs\PHPStan\Rule\ServiceAutowireRule
		arguments:
			reportUnavailable: %drupheusCs.autowire.reportUnavailable%
	- DrupheusCs\PHPStan\Rule\ProceduralHooksRule
	- DrupheusCs\PHPStan\Rule\PluginAttributesRule
	- DrupheusCs\PHPStan\Rule\TypedPropertiesRule
