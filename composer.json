{
    "name": "drupheus/drupheus-cs",
    "description": "Drupal coding standards, deprecation checks and modernization rules for Drupal 11+ contrib development, built on PHP_CodeSniffer, PHPStan and Rector.",
    "type": "phpcodesniffer-standard",
    "license": "GPL-2.0-or-later",
    "keywords": ["drupal", "coding standards", "phpcs", "phpstan", "rector", "dev"],
    "homepage": "https://github.com/marcopagliarulo/drupheus-cs",
    "support": {
        "issues": "https://github.com/marcopagliarulo/drupheus-cs/issues",
        "source": "https://github.com/marcopagliarulo/drupheus-cs"
    },
    "require": {
        "php": ">=8.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "drupal/coder": "^8.3.31 || ^9.0",
        "mglaman/phpstan-drupal": "^2.4",
        "palantirnet/drupal-rector": "^1.2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3.5",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "rector/rector": "^2.8.4",
        "slevomat/coding-standard": "^8.22",
        "squizlabs/php_codesniffer": "^3.13 || ^4.0.1",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
        "vincentlanglet/twig-cs-fixer": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "conflict": {
        "drupal/core": "<11.0"
    },
    "autoload": {
        "psr-4": {
            "DrupheusCs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DrupheusCs\\Tests\\": "tests/src/"
        }
    },
    "bin": ["bin/drupheus-cs"],
    "extra": {
        "phpstan": {
            "includes": ["config/extension.neon"]
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
